# LLM API 베이스 URL (리포트 초안 생성에 사용, Task 6에서 소비)
NEARMISS_API_BASE_URL=

# LLM API 키 — 절대 코드에 하드코딩하지 말 것
NEARMISS_API_KEY=

# 사용할 LLM 모델 이름
NEARMISS_MODEL=

# 관리자 전용 엔드포인트 접근 토큰 (Task 3에서 소비)
NEARMISS_ADMIN_TOKEN=

# 리포트 완료 알림을 보낼 웹훅 URL (선택)
NEARMISS_WEBHOOK_URL=

# LLM 호출 모드 — 비워두면 실제 호출("live"), "mock"이면 LLM 호출 없이 더미 응답 사용
NEARMISS_LLM_MODE=

# SQLite DB 파일 경로 — 비워두면 저장소 루트의 nearmiss.db 사용
NEARMISS_DB_PATH=

# 사내 GPT API 호출 타임아웃(초) — 비워두면 120. 응답 지연을 모르는 전제라
# 넉넉히 두었고, 데모 중 느리면 이 값만 올리면 된다.
NEARMISS_REQUEST_TIMEOUT=

# 사진 저장 디렉터리 — 비워두면 server/data/photos
NEARMISS_PHOTO_DIR=

# 집계 구간을 나눌 현장 시간대 — 비워두면 Asia/Seoul
# (시각 저장은 항상 UTC. 이 값은 '오늘'·시간대별 구간을 나눌 때만 쓴다)
NEARMISS_TIMEZONE=

# ── LLM 엔드포인트 경로 ────────────────────────────────────────────
# OpenAI 호환 API라도 경로 배치가 제각각이다. 비워두면 /v1/chat/completions.
#   OpenAI, 대부분의 사내 게이트웨이 : /v1/chat/completions  (기본값)
#   Gemini (OpenAI 호환 모드)        : /chat/completions
NEARMISS_CHAT_PATH=

# ── Gemini 무료 등급으로 쓰는 경우 ─────────────────────────────────
# 키 발급: https://aistudio.google.com/apikey (Google 계정, 결제수단 불필요)
# 위 세 값을 이렇게 채운다:
#   NEARMISS_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   NEARMISS_CHAT_PATH=/chat/completions
#   NEARMISS_MODEL=gemini-2.0-flash
#   NEARMISS_API_KEY=<발급받은 키>
#
# 주의: 무료 등급은 보낸 데이터를 모델 개선에 쓸 수 있다. 데모용 합성 데이터는
# 괜찮지만, 실제 현장 신고를 넣기 전에는 다시 판단해야 한다.
